meta {
  name    = "sample"
  dialect = "postgres"
}

view "core" {
  include = ["users", "posts", "comments"]
}

table "comments" {
  column "id" {
    type = "bigint"
    null = false
  }
  column "post_id" {
    type = "bigint"
    null = false
  }
  column "author_id" {
    type = "bigint"
    null = false
  }
  column "body" {
    type = "text"
    null = false
  }

  primary_key {
    columns = ["id"]
  }

  foreign_key "comments_post_id_fkey" {
    columns     = ["post_id"]
    ref_table   = "posts"
    ref_columns = ["id"]
    on_delete   = "cascade"
  }

  foreign_key "comments_author_id_fkey" {
    columns     = ["author_id"]
    ref_table   = "users"
    ref_columns = ["id"]
  }
}

table "posts" {
  column "id" {
    type = "bigint"
    null = false
  }
  column "author_id" {
    type = "bigint"
    null = false
  }
  column "title" {
    type = "text"
    null = false
  }

  primary_key {
    columns = ["id"]
  }

  foreign_key "posts_author_id_fkey" {
    columns     = ["author_id"]
    ref_table   = "users"
    ref_columns = ["id"]
  }
}

table "users" {
  column "id" {
    type = "bigint"
    null = false
  }
  column "email" {
    type = "text"
    null = false
  }
  column "name" {
    type = "text"
    null = true
  }

  primary_key {
    columns = ["id"]
  }

  index "users_email_key" {
    columns = ["email"]
    unique  = true
  }
}
